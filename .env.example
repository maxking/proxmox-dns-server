# DNS zone to serve (required)
DNS_ZONE=p01.example.com

# Proxmox API URL (required)
PVE_API_URL=https://proxmox:8006

# Proxmox API token ID (required)
PVE_API_TOKEN_ID=root@pam!dns

# Proxmox API token secret (required)
PVE_API_TOKEN_SECRET=your-api-token-secret-here

# IP prefix filter (optional, defaults to 192.168.)
IP_PREFIX=192.168.
