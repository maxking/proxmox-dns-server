# Proxmox DNS Server Configuration

# DNS zone to serve (REQUIRED)
# Example: p01.araj.me
# This will resolve:
#   - 102.p01.araj.me -> IP of container/VM with ID 102
#   - mycontainer.p01.araj.me -> IP of container/VM named 'mycontainer'
DNS_ZONE=p01.araj.me

# Port to listen on (default: 53)
DNS_PORT=53

# Network interface to bind to (optional, leave empty for all interfaces)
# Example: eth0, vmbr0
DNS_INTERFACE=
